import sys
from PyQt6.QtWidgets import QApplication, QMainWindow, QPushButton

class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Midterm Exam in OOP")
        self.setGeometry(200, 200, 800, 600)

        self.btn = QPushButton("Click to Change Color", self)
        self.btn.resize(300, 60)
        self.btn.move(250, 270)
        self.btn.clicked.connect(self.change_color)

    def change_color(self):
        self.btn.setStyleSheet("background-color: yellow;")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()
    sys.exit(app.exec())
