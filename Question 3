import sys
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QLabel, QLineEdit, QPushButton)
from PyQt6.QtGui import QFont

class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Midterm Exam in OOP")
        self.setGeometry(100, 100, 450, 250)

        #Enter fullname
        self.label_question = QLabel("Enter your fullname:", self)
        self.label_question.setGeometry(30, 50, 150, 30)
        self.label_question.setStyleSheet("color: red;")

        #Input box for Full Name
        self.fullname = QLineEdit(self)
        self.fullname.setFont(QFont("Calibri", 12))
        self.fullname.setGeometry(200, 50, 200, 30)
        
        #cilckable display fullname button
        self.button = QPushButton("Click to display your Fullname", self)
        self.button.setGeometry(30, 110, 160, 30)
        self.button.setStyleSheet("color: red;")
        self.button.clicked.connect(self.display_fullname)

        #Output (Read-only) for line edit display
        self.output = QLineEdit(self)
        self.output.setGeometry(200, 110, 200, 30)
        self.output.setFont(QFont("Calibri", 12))
        self.output.setReadOnly(True)

    def display_fullname(self):
        text = self.fullname.text()
        self.output.setText(text)
    
if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()
    sys.exit(app.exec())
